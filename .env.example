# KrishiNova Environment Variables

# API Keys
GOOGLE_API_KEY=your_google_api_key
WEATHER_API_KEY=your_weather_api_key
SARVAM_AI_API_KEY=your_sarvam_api_key

# Delta Lake Configuration
DELTA_LAKE_PATH=/data/delta_lake
SPARK_WAREHOUSE_DIR=/data/warehouse

# Airflow Configuration
AIRFLOW_HOME=/opt/airflow
AIRFLOW_DAGS_FOLDER=/opt/airflow/dags

# Database URLs
REDIS_URL=redis://localhost:6379
MONGO_URI=mongodb://localhost:27017/krishinova

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
FRONTEND_PORT=3000
